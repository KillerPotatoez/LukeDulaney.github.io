# Response headers for Cloudflare Pages / Netlify.
#
# IMPORTANT - why the CSP is not on /* :
# When two Content-Security-Policy headers apply to one response, the browser
# enforces the INTERSECTION of both, not the more specific one. A blanket CSP on
# /* carrying `connect-src 'none'` would therefore still apply to sw.js and stop
# the service worker filling its cache, no matter what the sw.js rule below said.
# So /* carries only the non-CSP security headers, and each path that needs a CSP
# gets exactly one.

/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()

# ---------------------------------------------------------------------------
# The app itself. connect-src 'none' and form-action 'none' mean the browser
# blocks every outbound request the page could make - fetch, XHR, WebSocket,
# sendBeacon, form post. The privacy claim on the page is enforced, not promised.
# ---------------------------------------------------------------------------

/tools/bone-age/
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'none'; form-action 'none'; frame-ancestors 'none'
  Cache-Control: no-cache

/tools/bone-age/index.html
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'none'; form-action 'none'; frame-ancestors 'none'
  Cache-Control: no-cache

# The worker needs connect-src 'self' so it can populate its own cache. It still
# cannot reach any other origin. Never let it be served from cache, or a broken
# version would pin itself in place.
/tools/bone-age/sw.js
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self'
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /tools/bone-age/

/tools/bone-age/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/tools/bone-age/*.png
  Cache-Control: public, max-age=86400
